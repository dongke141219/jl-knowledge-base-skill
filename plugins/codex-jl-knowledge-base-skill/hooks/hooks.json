{
  "description": "JL lifecycle checks for Codex. Review and trust with /hooks before use.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/jl_lifecycle.py\" || python \"$PLUGIN_ROOT/hooks/jl_lifecycle.py\"",
            "commandWindows": "cmd.exe /d /c \"\"%PLUGIN_ROOT%\\hooks\\run_jl_lifecycle.cmd\"\"",
            "timeout": 5,
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "(?:create_knowledge_task|query_task_fragments|submit_knowledge_candidate|report_client_update)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/jl_lifecycle.py\" || python \"$PLUGIN_ROOT/hooks/jl_lifecycle.py\"",
            "commandWindows": "cmd.exe /d /c \"\"%PLUGIN_ROOT%\\hooks\\run_jl_lifecycle.cmd\"\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(?:Bash|Shell|exec_command|run_shell_command|create_knowledge_task|query_task_fragments|submit_knowledge_candidate|report_client_update)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/jl_lifecycle.py\" || python \"$PLUGIN_ROOT/hooks/jl_lifecycle.py\"",
            "commandWindows": "cmd.exe /d /c \"\"%PLUGIN_ROOT%\\hooks\\run_jl_lifecycle.cmd\"\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/jl_lifecycle.py\" || python \"$PLUGIN_ROOT/hooks/jl_lifecycle.py\"",
            "commandWindows": "cmd.exe /d /c \"\"%PLUGIN_ROOT%\\hooks\\run_jl_lifecycle.cmd\"\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
