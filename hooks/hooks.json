{
  "description": "JL lifecycle checks for Gemini CLI.",
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "JL task start",
            "command": "node \"${extensionPath}${/}hooks${/}python-launcher.mjs\"",
            "timeout": 5000,
            "description": "Start or continue the JL task lifecycle."
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "(?:create_knowledge_task|query_task_fragments|submit_knowledge_candidate|report_client_update)$",
        "hooks": [
          {
            "type": "command",
            "name": "JL bounded knowledge call",
            "command": "node \"${extensionPath}${/}hooks${/}python-launcher.mjs\"",
            "timeout": 5000,
            "description": "Prevent duplicate task, query, and candidate calls."
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "(?:run_shell_command|create_knowledge_task|query_task_fragments|submit_knowledge_candidate|report_client_update)$",
        "hooks": [
          {
            "type": "command",
            "name": "JL task evidence",
            "command": "node \"${extensionPath}${/}hooks${/}python-launcher.mjs\"",
            "timeout": 5000,
            "description": "Record consent and bounded knowledge results."
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "JL task closeout",
            "command": "node \"${extensionPath}${/}hooks${/}python-launcher.mjs\"",
            "timeout": 5000,
            "description": "Apply at most one closeout reminder."
          }
        ]
      }
    ]
  }
}
